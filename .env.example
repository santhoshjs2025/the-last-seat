# Environment Configuration
PROJECT_NAME="The Last Seat"
ENVIRONMENT="development"
DEBUG=false

# Database Configuration
# -------------------------------------------------------------------------------------------------
# 1. Local Demo / Standalone Mode (SQLite - No Docker or PostgreSQL required):
DATABASE_URL=sqlite:///./the_last_seat.db

# 2. Production Mode (PostgreSQL with Docker Compose or external server):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/the_last_seat
# In Docker Compose container network: postgresql+psycopg://postgres:postgres@db:5432/the_last_seat
# -------------------------------------------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Business Logic Configuration
RESERVATION_EXPIRY_MINUTES=5
EXPIRY_WORKER_INTERVAL_SECONDS=10
TOTAL_SEATS=500
MAX_PAYMENT_SIMULATED_DELAY_SECONDS=30

# Security
ADMIN_API_KEY=admin-dev-key-change-in-production
